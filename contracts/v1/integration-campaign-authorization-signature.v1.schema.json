{
  "$id": "https://schemas.foigent.local/foigent.integration-campaign-authorization-signature.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Detached purpose-separated Ed25519 signature envelope for a canonical authorization artifact.",
  "properties": {
    "algorithm": {
      "const": "ed25519",
      "type": "string"
    },
    "authorization_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "domain": {
      "const": "foigent.integration-campaign-authorization.v1",
      "type": "string"
    },
    "purpose": {
      "const": "integration_campaign_authorization",
      "type": "string"
    },
    "schema_version": {
      "const": "foigent.integration-campaign-authorization-signature.v1",
      "type": "string"
    },
    "signer_public_key_id": {
      "pattern": "^ed25519:sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "signing_key_ref": {
      "maxLength": 160,
      "pattern": "^integration-authorization-[A-Za-z0-9._:/-]+$",
      "type": "string"
    },
    "trust_set_sha256": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "value": {
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "purpose",
    "domain",
    "signing_key_ref",
    "signer_public_key_id",
    "trust_set_sha256",
    "authorization_sha256",
    "algorithm",
    "value"
  ],
  "title": "foigent.integration-campaign-authorization-signature.v1",
  "type": "object"
}
